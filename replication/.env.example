# Copiar este archivo como .env, en esta misma carpeta, y completar los valores antes
# de ejecutar `docker compose up -d`. Ninguno de estos valores es el utilizado durante
# la campaña de la tesis.

# --- PostgreSQL (servicio db) ---
POSTGRES_USER=cambiar_usuario
POSTGRES_PASSWORD=cambiar_contrasena
# Base interna de n8n. La base de la investigación (secops_research_db) la crea
# init-db.sh aparte.
POSTGRES_DB=n8n_internal

# --- Conexión de n8n a su base interna ---
# Los scripts de inicialización no crean otro usuario: usar los mismos valores que
# POSTGRES_USER y POSTGRES_PASSWORD.
DB_POSTGRESDB_USER=cambiar_usuario
DB_POSTGRESDB_PASSWORD=cambiar_contrasena

# --- Secretos de n8n: generar valores aleatorios largos ---
N8N_USER_MANAGEMENT_JWT_SECRET=cambiar_por_valor_aleatorio
N8N_ENCRYPTION_KEY=cambiar_por_valor_aleatorio
# true o false; false conserva el historial completo de ejecuciones.
EXECUTIONS_DATA_PRUNE=false

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@ejemplo.org
PGADMIN_DEFAULT_PASSWORD=cambiar_contrasena
